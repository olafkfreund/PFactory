#!/bin/sh

echo "Running pre-commit checks..."

# =============================================================================
# VERSION SYNC - Keep all version references in sync with root package.json
# =============================================================================

# Check if package.json is staged
if git diff --cached --name-only | grep -q "^package.json$"; then
  echo "package.json changed, syncing version to all files..."

  # Extract version from root package.json
  VERSION=$(node -p "require('./package.json').version")

  if [ -n "$VERSION" ]; then
    # Sync to apps/frontend/package.json
    if [ -f "apps/frontend/package.json" ]; then
      node -e "
        const fs = require('fs');
        const pkg = require('./apps/frontend/package.json');
        if (pkg.version !== '$VERSION') {
          pkg.version = '$VERSION';
          fs.writeFileSync('./apps/frontend/package.json', JSON.stringify(pkg, null, 2) + '\n');
          console.log('  Updated apps/frontend/package.json to $VERSION');
        }
      "
      git add apps/frontend/package.json
    fi

    # Sync to apps/backend/__init__.py
    if [ -f "apps/backend/__init__.py" ]; then
      sed -i.bak "s/__version__ = \"[^\"]*\"/__version__ = \"$VERSION\"/" apps/backend/__init__.py
      rm -f apps/backend/__init__.py.bak
      git add apps/backend/__init__.py
      echo "  Updated apps/backend/__init__.py to $VERSION"
    fi

    # Sync to README.md - section-aware updates (stable vs beta)
    if [ -f "README.md" ]; then
      # Escape hyphens for shields.io badge format (shields.io uses -- for literal hyphens)
      ESCAPED_VERSION=$(echo "$VERSION" | sed 's/-/--/g')

      # Detect if this is a prerelease (contains - after base version, e.g., 2.7.2-beta.10)
      if echo "$VERSION" | grep -q '-'; then
        # PRERELEASE: Update only beta sections
        echo "  Detected PRERELEASE version: $VERSION"

        # Update beta version badge (orange)
        sed -i.bak "s/beta-[0-9]*\.[0-9]*\.[0-9]*\(--[a-z]*\.[0-9]*\)*-orange/beta-$ESCAPED_VERSION-orange/g" README.md

        # Update beta version badge link (within BETA_VERSION_BADGE section)
        sed -i.bak '/<!-- BETA_VERSION_BADGE -->/,/<!-- BETA_VERSION_BADGE_END -->/s|releases/tag/v[0-9.a-z-]*)|releases/tag/v'"$VERSION"')|g' README.md

        # Update beta download links (within BETA_DOWNLOADS section only)
        for SUFFIX in "win32-x64.exe" "darwin-arm64.dmg" "darwin-x64.dmg" "linux-x86_64.AppImage" "linux-amd64.deb" "linux-x86_64.flatpak"; do
          sed -i.bak '/<!-- BETA_DOWNLOADS -->/,/<!-- BETA_DOWNLOADS_END -->/{s|PFactory-[0-9.a-z-]*-'"$SUFFIX"'](https://github.com/dataseeek/PFactory/releases/download/v[^/]*/PFactory-[^)]*-'"$SUFFIX"')|PFactory-'"$VERSION"'-'"$SUFFIX"'](https://github.com/dataseeek/PFactory/releases/download/v'"$VERSION"'/PFactory-'"$VERSION"'-'"$SUFFIX"')|g}' README.md
        done
      else
        # STABLE: Update stable sections and top badge
        echo "  Detected STABLE version: $VERSION"

        # Update top version badge (blue) - within TOP_VERSION_BADGE section
        sed -i.bak '/<!-- TOP_VERSION_BADGE -->/,/<!-- TOP_VERSION_BADGE_END -->/s/version-[0-9]*\.[0-9]*\.[0-9]*\(--[a-z]*\.[0-9]*\)*-blue/version-'"$ESCAPED_VERSION"'-blue/g' README.md
        sed -i.bak '/<!-- TOP_VERSION_BADGE -->/,/<!-- TOP_VERSION_BADGE_END -->/s|releases/tag/v[0-9.a-z-]*)|releases/tag/v'"$VERSION"')|g' README.md

        # Update stable version badge (blue) - within STABLE_VERSION_BADGE section
        sed -i.bak '/<!-- STABLE_VERSION_BADGE -->/,/<!-- STABLE_VERSION_BADGE_END -->/s/stable-[0-9]*\.[0-9]*\.[0-9]*\(--[a-z]*\.[0-9]*\)*-blue/stable-'"$ESCAPED_VERSION"'-blue/g' README.md
        sed -i.bak '/<!-- STABLE_VERSION_BADGE -->/,/<!-- STABLE_VERSION_BADGE_END -->/s|releases/tag/v[0-9.a-z-]*)|releases/tag/v'"$VERSION"')|g' README.md

        # Update stable download links (within STABLE_DOWNLOADS section only)
        for SUFFIX in "win32-x64.exe" "darwin-arm64.dmg" "darwin-x64.dmg" "linux-x86_64.AppImage" "linux-amd64.deb"; do
          sed -i.bak '/<!-- STABLE_DOWNLOADS -->/,/<!-- STABLE_DOWNLOADS_END -->/{s|PFactory-[0-9.a-z-]*-'"$SUFFIX"'](https://github.com/dataseeek/PFactory/releases/download/v[^/]*/PFactory-[^)]*-'"$SUFFIX"')|PFactory-'"$VERSION"'-'"$SUFFIX"'](https://github.com/dataseeek/PFactory/releases/download/v'"$VERSION"'/PFactory-'"$VERSION"'-'"$SUFFIX"')|g}' README.md
        done
      fi

      rm -f README.md.bak
      git add README.md
      echo "  Updated README.md to $VERSION"
    fi

    echo "Version sync complete: $VERSION"
  fi
fi

# =============================================================================
# PYTHON LINT RATCHET - must agree with CI (issue #389)
# =============================================================================

# Same gate as the cq-ratchet CI job: scripts/ratchet_lint.py with the same
# config (ruff.toml -> standards/ruff.toml) and the same packages, judging the
# same thing - a changed file may not GAIN ruff violations vs HEAD. Pre-existing
# debt in a touched file never blocks a commit; a net-new violation does.
# The mypy half of the ratchet stays CI-only (too slow for a hook).
STAGED_PY_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep "^apps/\(backend\|web-server\)/.*\.py$" || true)
if [ -n "$STAGED_PY_FILES" ]; then
  # Determine ruff command (venv or global)
  RUFF=""
  if [ -f "apps/backend/.venv/bin/ruff" ]; then
    RUFF="apps/backend/.venv/bin/ruff"
  elif [ -f "apps/backend/.venv/Scripts/ruff.exe" ]; then
    RUFF="apps/backend/.venv/Scripts/ruff.exe"
  elif command -v ruff >/dev/null 2>&1; then
    RUFF="ruff"
  fi

  # The rewrite steps below are gated on the ruff version, not just on ruff
  # existing (#452). This hook does not merely lint: it runs `--fix`, it runs
  # `format`, and it `git add`s the result. So a version skew does not produce a
  # warning, it produces a commit. Hit for real with a local ruff 0.14.10:
  # formatting apps/backend/plan/service.py collapsed eleven import blocks that
  # the pinned 0.15.17 keeps exploded -- a 44-line unrelated diff, staged
  # automatically, which then reddened the blocking CI format check on a file the
  # author never meant to touch. The cause (the hook, not the edit) is invisible
  # from the diff.
  #
  # ci.yml's RUFF_VERSION is the declared single source of truth for the pin and
  # is already agreement-tested against every other workflow and the
  # pre-commit-config rev (tests/test_ruff_pin_agreement.py). Read it rather than
  # writing the number down a fourth time.
  PINNED_RUFF=""
  if [ -f ".github/workflows/ci.yml" ]; then
    PINNED_RUFF=$(sed -n 's/^[[:space:]]*RUFF_VERSION:[[:space:]]*"\{0,1\}\([0-9][^"[:space:]]*\).*/\1/p' \
      .github/workflows/ci.yml | head -1)
  fi
  LOCAL_RUFF=""
  if [ -n "$RUFF" ]; then
    LOCAL_RUFF=$($RUFF --version 2>/dev/null | awk '{print $2}')
  fi

  RUFF_PIN_OK=0
  if [ -n "$RUFF" ] && [ -n "$PINNED_RUFF" ] && [ "$LOCAL_RUFF" = "$PINNED_RUFF" ]; then
    RUFF_PIN_OK=1
  fi

  if [ -n "$RUFF" ] && [ "$RUFF_PIN_OK" -eq 0 ]; then
    echo ""
    echo "  ruff version skew - SKIPPING autofix/format/re-stage."
    echo "    pinned by .github/workflows/ci.yml: ${PINNED_RUFF:-<could not read>}"
    echo "    found at ${RUFF}: ${LOCAL_RUFF:-<could not read>}"
    echo ""
    echo "  This hook rewrites and re-stages your files. Doing that with the wrong"
    echo "  ruff lands formatting churn you did not ask for and reddens the blocking"
    echo "  CI format check on files your change never touched, so it does nothing"
    echo "  instead. Your commit is NOT blocked."
    echo ""
    echo "  Install the pin:  cd apps/backend && uv pip install 'ruff==${PINNED_RUFF:-<see ci.yml>}'"
    echo "  The ratchet below still runs, but with an unpinned ruff its verdict is"
    echo "  advisory - CI's is the one that counts."
    echo ""
  fi

  if [ -n "$RUFF" ] && [ "$RUFF_PIN_OK" -eq 1 ]; then
    # Auto-fix and format with the REPO config, best-effort: remaining
    # violations are judged by the ratchet below, not by ruff's exit code
    # (a bare blocking `ruff check` rejects commits over pre-existing debt
    # the commit never touched - see #389). --force-exclude keeps ruff off
    # the vendored byte-exact mirrors excluded in ruff.toml.
    echo "Running ruff autofix + format (repo config, ruff ${LOCAL_RUFF}) on staged files..."
    echo "$STAGED_PY_FILES" | xargs $RUFF check --fix --force-exclude --config ruff.toml || true
    echo "$STAGED_PY_FILES" | xargs $RUFF format --force-exclude --config ruff.toml

    # Re-stage only the files that were originally staged (in case ruff modified them)
    echo "$STAGED_PY_FILES" | xargs git add
  fi

  if [ -n "$RUFF" ]; then
    # Block only NET-NEW violations, exactly as CI does (index vs HEAD).
    RATCHET_PY="python3"
    if [ -f "apps/backend/.venv/bin/python" ]; then
      RATCHET_PY="apps/backend/.venv/bin/python"
    elif [ -f "apps/backend/.venv/Scripts/python.exe" ]; then
      RATCHET_PY="apps/backend/.venv/Scripts/python.exe"
    fi
    echo "Running lint ratchet (net-new violations vs HEAD)..."
    PATH="$(pwd)/apps/backend/.venv/bin:$(pwd)/apps/backend/.venv/Scripts:$PATH" \
      "$RATCHET_PY" scripts/ratchet_lint.py --staged --package apps/backend --package apps/web-server
    if [ $? -ne 0 ]; then
      echo "Lint ratchet failed: this commit ADDS ruff violations (pre-existing debt never blocks)."
      exit 1
    fi
  else
    echo "Warning: ruff not found, skipping Python lint ratchet. Install with: uv pip install ruff"
  fi
fi

# =============================================================================
# BACKEND CHECKS (Python) - Run first, before frontend
# =============================================================================

# Check if there are staged Python files in apps/backend
if git diff --cached --name-only | grep -q "^apps/backend/.*\.py$"; then
  echo "Python changes detected, running backend checks..."

  # Run pytest (skip slow/integration tests and Windows-incompatible tests for pre-commit speed)
  echo "Running Python tests..."
  # During `git commit`, git exports per-repo env (GIT_DIR, GIT_INDEX_FILE,
  # GIT_WORK_TREE) into this hook. Tests that shell out to git in their own
  # tmp repos inherit it and then operate on THIS repo's index instead - they
  # fail under the hook while passing standalone, and can corrupt the staged
  # index (#389). GIT_CONFIG_PARAMETERS carries the invoking commit's `-c`
  # overrides (e.g. core.hooksPath) into every child git, which makes tmp-repo
  # commits inside tests re-run this very hook. Strip all of it for the test
  # run; nothing after this point needs it.
  unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_OBJECT_DIRECTORY GIT_CONFIG_PARAMETERS
  cd apps/backend
  # Tests to skip:
  #   graphiti: external deps
  #   merge_file_tracker/service_orchestrator/worktree/workspace: Windows path/git issues
  #   rmux/: requires web-server deps (fastapi/jose/aiosqlite etc.) not in backend venv
  #   secrets/: requires sqlalchemy async + postgres driver
  #   qa* / spec* / critique* / git_providers* / validation_strategy / test_plan_validator_resilience:
  #     reference deleted modules (qa, qa_loop, spec, ideation) — dead test artifacts
  #     from the AIFactory→PFactory fork cleanup; these will never be fixed in PFactory.
  IGNORE_TESTS="--ignore=../../tests/test_graphiti.py \
    --ignore=../../tests/test_merge_file_tracker.py \
    --ignore=../../tests/test_service_orchestrator.py \
    --ignore=../../tests/test_worktree.py \
    --ignore=../../tests/test_workspace.py \
    --ignore=../../tests/rmux/ \
    --ignore=../../tests/secrets/ \
    --ignore=../../tests/test_critique_integration.py \
    --ignore=../../tests/test_git_providers_assign.py \
    --ignore=../../tests/test_mcp_doctor.py \
    --ignore=../../tests/test_qa_criteria.py \
    --ignore=../../tests/test_qa_loop.py \
    --ignore=../../tests/test_qa_loop_enhancements.py \
    --ignore=../../tests/test_qa_providers.py \
    --ignore=../../tests/test_qa_report_config.py \
    --ignore=../../tests/test_qa_report_iteration.py \
    --ignore=../../tests/test_qa_report_manual_plan.py \
    --ignore=../../tests/test_qa_report_project_detection.py \
    --ignore=../../tests/test_qa_report_recurring.py \
    --ignore=../../tests/test_spec_complexity.py \
    --ignore=../../tests/test_spec_phases.py \
    --ignore=../../tests/test_spec_pipeline.py \
    --ignore=../../tests/test_test_plan_validator_resilience.py \
    --ignore=../../tests/test_validation_strategy.py"
  if [ -d ".venv" ]; then
    # Use venv if it exists
    if [ -f ".venv/bin/pytest" ]; then
      PYTHONPATH=. .venv/bin/pytest ../../tests/ -v --tb=short -x -m "not slow and not integration" $IGNORE_TESTS
    elif [ -f ".venv/Scripts/pytest.exe" ]; then
      # Windows
      PYTHONPATH=. .venv/Scripts/pytest.exe ../../tests/ -v --tb=short -x -m "not slow and not integration" $IGNORE_TESTS
    else
      PYTHONPATH=. python -m pytest ../../tests/ -v --tb=short -x -m "not slow and not integration" $IGNORE_TESTS
    fi
  else
    PYTHONPATH=. python -m pytest ../../tests/ -v --tb=short -x -m "not slow and not integration" $IGNORE_TESTS
  fi
  if [ $? -ne 0 ]; then
    echo "Python tests failed. Please fix failing tests before committing."
    exit 1
  fi
  cd ../..

  echo "Backend checks passed!"
fi

# =============================================================================
# FRONTEND CHECKS (TypeScript/React)
# =============================================================================

# Check if there are staged files in apps/frontend
if git diff --cached --name-only | grep -q "^apps/frontend/"; then
  echo "Frontend changes detected, running frontend checks..."
  cd apps/frontend

  # Run lint-staged (handles staged .ts/.tsx files)
  npm exec lint-staged
  if [ $? -ne 0 ]; then
    echo "lint-staged failed. Please fix linting errors before committing."
    exit 1
  fi

  # Run TypeScript type check
  echo "Running type check..."
  npm run typecheck
  if [ $? -ne 0 ]; then
    echo "Type check failed. Please fix TypeScript errors before committing."
    exit 1
  fi

  # Run linting
  echo "Running lint..."
  npm run lint
  if [ $? -ne 0 ]; then
    echo "Lint failed. Run 'npm run lint:fix' to auto-fix issues."
    exit 1
  fi

  # Check for vulnerabilities (only high severity)
  echo "Checking for vulnerabilities..."
  npm audit --audit-level=high
  if [ $? -ne 0 ]; then
    echo "High severity vulnerabilities found. Run 'npm audit fix' to resolve."
    exit 1
  fi

  cd ../..
  echo "Frontend checks passed!"
fi

echo "All pre-commit checks passed!"
