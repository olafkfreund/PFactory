# =============================================================================
# PFactory — root .env.example
# =============================================================================
# Copy to `.env` next to docker-compose.yml and override values as needed.
#
# This file is for the LOCAL DEV docker-compose deployment AND as a
# reference index of PFactory env vars. Production deployments use
# the Helm chart — see guides/deployment/runbook.md.
#
# Per-app envs live alongside their app:
#   - Web-server portal:  apps/web-server/.env.example
#   - Backend agents:     (no per-app .env.example yet; vars listed below)
#
# For the COMPLETE, exhaustive reference (every var, default, purpose, and the
# file it is read in), see docs/dev/environment-reference.md.
# =============================================================================


# ─── docker-compose host port mapping ──────────────────────────────────
# Host port the web server is published to. Default 3114 matches APP_PORT.
# HOST_PORT=3114


# ─── docker-compose persistent data ────────────────────────────────────
# Bind-mounted at /home/nonroot/.pfactory inside the container. Holds the
# auto-generated API token, project metadata, audit log SQLite (until P1
# Postgres migration lands).
# PFACTORY_DATA_DIR=./data


# ─── Container runtime overrides (forwarded into the container) ────────
# Auto-generated on first run if unset.
# APP_API_TOKEN=

# Set via the UI OAuth flow instead (preferred).
# CLAUDE_CODE_OAUTH_TOKEN=

# Extra CORS origins for the web-server (comma-separated or JSON list).
# APP_CORS_ORIGINS=https://my-host.example.com:3114,http://my-host.example.com:3115


# ─── Agent LLM provider keys (used by Planner / Gen-Functional /
#     Evaluator / Triager when they call out via the providers/factory) ─
# At least ONE of these must be set for the pipeline to run.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AZURE_OPENAI_API_KEY=
# GOOGLE_API_KEY=
# VOYAGE_API_KEY=


# ─── PFactory workspace + pipeline ─────────────────────────────────────
# Workspace root that the portal endpoints + the agents read/write from.
# Default ~/.pfactory.
# PFACTORY_WORKSPACE_ROOT=~/.pfactory
# Per-run input/output roots (default under the workspace root when unset).
# PROJECT_WORKSPACE_ROOT=          # portal per-project workspace root
# PFACTORY_WORKSPACES_DIR=         # plan-service workspaces dir
# PFACTORY_PROJECT_DIR=            # MCP: source repo the planner reads
# PFACTORY_SPEC_DIR=               # MCP: spec/plan input dir
# PFACTORY_DOCS_DIR=               # emitted-docs output dir
# PFACTORY_PLAN_STORE_DIR=         # signed-plan persistence dir
# PFACTORY_SKILLS_DIR=             # backend skills lookup dir
# APP_SKILLS_PATH=                 # web-server skills lookup dir
# PFACTORY_CLOUD_ASSESSMENT_ROOT=  # cloud feasibility artifact root
# PFACTORY_VISUAL_INSPECTION_ROOT= # visual-inspection artifact root
# Custom test-agent command the executor shells out to (empty = built-in).
# PFACTORY_TEST_AGENT_CMD=

# Auto-fire chain envs — each defaults to "1" (auto-advance ON). Test
# fixtures set to "0"; operators may pin some OFF to inspect each stage.
# PFACTORY_AUTO_PLAN=1       # Planner auto-fires from task_create_and_run
# PFACTORY_AUTO_GENERATE=1   # Gen-Functional auto-fires from Planner
# PFACTORY_AUTO_EVALUATE=1   # Evaluator auto-fires from Gen-Functional
# PFACTORY_AUTO_TRIAGE=1     # Triager auto-fires from Evaluator


# ─── Triager side-effect modes (default DRY-RUN — opt in to real-run) ──
# Per CLAUDE.md: "NO automatic pushes to GitHub" — keep these off unless
# the operator has confirmed git_writer/pr_comment are safe.
# PFACTORY_TRIAGER_GIT_WRITE=0     # commit accepted tests to feature branch
# PFACTORY_TRIAGER_PR_COMMENT=0    # post triage report via gh pr comment
# PFACTORY_TRIAGER_HARVEST=0       # harvest triage insights into memory
# PFACTORY_TRIAGER_HARVEST_GLOBAL=0 # harvest to the global (cross-project) store


# ─── AIFactory project location (used by the snapshotter + e2e smoke) ──
# Local path to the AIFactory checkout PFactory operates on.
# PFACTORY_AIFACTORY_ROOT=/home/user/Source/GitHub/MyApp
# Feature branch carrying the change to test:
# PFACTORY_AIFACTORY_BRANCH=feature/example-change
# PR number for scenario 7 of the e2e smoke:
# PFACTORY_AIFACTORY_PR=42


# ─── Docker runner (Task 4) ────────────────────────────────────────────
# Container image used by the Executor's sandboxed pytest run.
# PFACTORY_DOCKER_IMAGE_PYTHON=pfactory-runner-python:latest
# Container CLI: docker (default) or podman.
# PFACTORY_CONTAINER_BIN=docker
#
# Registry that bare `pfactory-runner-*` tags resolve to (#449).
#
#   unset (default)  ghcr.io/olafkfreund — the images runner-images.yml builds,
#                    publishes and signs from a commit. This is what you want
#                    unless you are changing a Dockerfile.
#   empty            no qualification: bare tags resolve against your local
#                    daemon, i.e. YOUR `docker build -t pfactory-runner-...`.
#                    The escape hatch for iterating on a runner image.
#   anything else    that registry/namespace (a mirror, or a fork's GHCR).
#
# Images that already carry a registry (anything with a "/") are never
# rewritten, so an explicitly requested image always wins.
# PFACTORY_RUNNER_REGISTRY=


# ─── e2e smoke state (test harness only) ───────────────────────────────
# Override per-run if you don't want successive runs to share state.
# PFACTORY_E2E_STATE_DIR=$HOME/.pfactory


# ─── Web server (pydantic Settings, prefix APP_) ───────────────────────
# APP_HOST=0.0.0.0
# APP_PORT=3114
# APP_DEBUG=false
# APP_SSL_ENABLED=false
# APP_SSL_CERTFILE=
# APP_SSL_KEYFILE=
# APP_MAX_TERMINALS=20
# APP_MAX_CONCURRENT_TASKS=5
# APP_DEFAULT_SHELL=/bin/bash
# On: run `alembic upgrade head` at boot. Off for out-of-band Helm migrations.
# APP_MIGRATIONS_AUTO_APPLY=true
# Federated cross-portal search proxy to the CFactory cockpit (empty = off).
# APP_CFACTORY_SEARCH_URL=http://cfactory.factory.svc.cluster.local:3111
# APP_CFACTORY_READ_KEY=
# Liveness watchdog (issue #95) — flags silent stages as stalled.
# APP_LIVENESS_SWEEP_ENABLED=false
# APP_LIVENESS_SWEEP_INTERVAL_SECONDS=300
# APP_LIVENESS_SWEEP_DEADLINE_SECONDS=600


# ─── Auth / JWT ────────────────────────────────────────────────────────
# JWT secret auto-generated + persisted to ~/.pfactory/.jwt_secret if unset.
# APP_JWT_SECRET=
# APP_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
# APP_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# APP_JWT_ALGORITHM=HS256
# DEV ONLY: inject a default admin and skip ALL auth. Loopback host only.
# APP_DISABLE_AUTH=false
# Escape hatch to allow DISABLE_AUTH off-loopback. NEVER set in production.
# APP_ALLOW_INSECURE_AUTH=false


# ─── SSO / OIDC (optional) ─────────────────────────────────────────────
# APP_OIDC_ENABLED=false
# APP_OIDC_PROVIDER=keycloak
# APP_OIDC_ISSUER_URL=https://sso.example.com/realms/pfactory
# APP_OIDC_CLIENT_ID=
# APP_OIDC_CLIENT_SECRET=
# APP_OIDC_SCOPE=
# APP_OIDC_REDIRECT_URI=
# APP_OIDC_POST_LOGIN_REDIRECT=/
# APP_OIDC_POST_LOGOUT_REDIRECT=/
# APP_OIDC_USERINFO_CACHE_TTL_S=300
# APP_OIDC_DEFAULT_ROLE=member
# APP_OIDC_GROUP_TO_ROLE={"admins":"admin"}
# APP_OIDC_DEFAULT_ORG_SLUG=default
# APP_OIDC_DEFAULT_ORG_NAME=Default Organization


# ─── MCP / remote API access ───────────────────────────────────────────
# Shared secret guarding the MCP JSON-RPC + plan-pipeline endpoints.
# PFACTORY_MCP_SECRET=
# PFACTORY_MCP_KEY=
# PFACTORY_MCP_REMOTE_ENABLED=false
# PFACTORY_MCP_LOOPBACK_URL=http://localhost:3114
# Bearer token required to scrape /metrics (empty leaves metrics open).
# METRICS_SCRAPE_TOKEN=
# CLI / in-agent HTTP client target (talks back to the running service).
# PFACTORY_API_URL=http://localhost:3114
# PFACTORY_API_TOKEN_FILE=~/.pfactory/.api_token
# PFACTORY_PORTAL_PORT=3114        # port the task-control tool dials


# ─── Database (Postgres in prod; sqlite auto-generated otherwise) ──────
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/pfactory
# PFACTORY_MAX_CONCURRENT_PLANS=4
# PFACTORY_PLAN_LEASE_TTL_SECONDS=600
# Hosted multi-tenant mode (scope sessions by X-Tenant-Id header).
# PFACTORY_MULTI_TENANT=false
# PFACTORY_PLAN_PERSIST=false
# PFACTORY_STALL_DEADLINE_SECONDS=900


# ─── Model selection & routing ─────────────────────────────────────────
# PFACTORY_ROUTING_POLICY=
# PFACTORY_PLANNER_PINNED_MODEL=
# PFACTORY_EXECUTION_MODEL=
# QA_LLM_PROVIDER=
# AUTO_BUILD_MODEL=
# UTILITY_MODEL_ID=
# UTILITY_THINKING_BUDGET=
# QUICK_MODE=false


# ─── Additional LLM providers ──────────────────────────────────────────
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_LLM_MODEL=
# OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com
# OPENAI_COMPATIBLE_API_KEY=
# AZURE_OPENAI_BASE_URL=
# AZURE_OPENAI_LLM_DEPLOYMENT=
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# Local / cloud Ollama.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_CLOUD_BASE_URL=https://ollama.com
# OLLAMA_API_KEY=
# OLLAMA_LLM_MODEL=
# OLLAMA_EMBEDDING_MODEL=
# OLLAMA_EMBEDDING_DIM=

# ─── Model / embedding overrides (per-provider defaults; leave unset) ──
# ANTHROPIC_BASE_URL=              # custom Anthropic-compatible gateway
# OPENAI_MODEL=
# OPENAI_EMBEDDING_MODEL=
# GOOGLE_LLM_MODEL=
# GOOGLE_EMBEDDING_MODEL=
# VOYAGE_EMBEDDING_MODEL=
# GRAPHITI_ANTHROPIC_MODEL=


# ─── Git / GitHub ──────────────────────────────────────────────────────
# GITHUB_TOKEN=
# GH_TOKEN=
# PFACTORY_RECON_TOKEN=
# PFACTORY_RECON_GIT_HOST=github.com
# PFACTORY_GITHUB_API_BASE=https://api.github.com
# DEFAULT_BRANCH=main
# FACTORY_SERVICE_NAME=the Factory


# ─── Feasibility, enrichment & recon ───────────────────────────────────
# PFACTORY_BUDGET_MONTHLY_USD=
# Comma-separated: aws,azure,gcp,kubernetes
# PFACTORY_ENRICH_ADAPTERS=
# PFACTORY_ENRICH_CONNECTORS=
# PFACTORY_WIKI_ROOT=
# KUBECONFIG=


# ─── Handoff / completion / stage events ───────────────────────────────
# PFACTORY_AIFACTORY_API_URL=http://localhost:3101
# PFACTORY_AIFACTORY_API_TOKEN=
# PFACTORY_AIFACTORY_HANDSHAKE=false
# PFACTORY_HANDBACK_PREPARE=false
# PFACTORY_HANDBACK_SEND=false
# PFACTORY_HANDBACK_MAX_CYCLES=2
# PFACTORY_COMPLETION_WEBHOOK=
# PFACTORY_COMPLETION_WEBHOOK_TIMEOUT=5
# PFACTORY_COMPLETION_SENTINEL=false
# PFACTORY_COMPLETION_SENTINEL_DIR=  # dir the completion sentinel file is written to
# PFACTORY_STAGE_EVENT_WEBHOOK=
# PFACTORY_STAGE_EVENT_WEBHOOK_TIMEOUT=5
# PFACTORY_STAGE_EVENT_SENTINEL=false
# PFACTORY_COPILOT_DISPATCH_ENABLED=false
# PFACTORY_PLAN_REVIEW_COMMENT=false


# ─── Security & execution ──────────────────────────────────────────────
# PFACTORY_EGRESS_ENABLED=false
# Allow raw provider API keys (vs OAuth-only) in the auth policy.
# PFACTORY_ALLOW_API_KEYS=false
# PFACTORY_STRICT_COMMAND_PARSING=false
# Red-team blocking severity: low | medium | high | critical
# PFACTORY_RED_TEAM_RISK_THRESHOLD=high
# Path to a JSON registry of extra plan-review extensions to load.
# PFACTORY_EXTENSION_REGISTRY=
# Toggle the bash sandbox for agent tool calls.
# AIFACTORY_BASH_SANDBOX=true
# PFACTORY_RMUX_ENABLED=false


# ─── Secrets backend / KMS (web-server crypto) ─────────────────────────
# Backend: fernet (default) | vault | aws | azure | gcp
# APP_KMS_BACKEND=fernet
# APP_KMS_FERNET_KEY=
# Un-prefixed aliases honored as a fallback when the APP_ form is unset.
# KMS_BACKEND=fernet
# KMS_FERNET_KEY=
# VAULT_ADDR=
# VAULT_TOKEN=
# VAULT_TRANSIT_KEY=
# VAULT_TRANSIT_MOUNT=
# VAULT_NAMESPACE=
# AWS_KMS_KEY_ID=
# AWS_ENDPOINT_URL=
# AZURE_KEYVAULT_URL=
# AZURE_KEYVAULT_KEY=
# GCP_KMS_KEY_NAME=


# ─── Memory (Graphiti) & insight extraction ────────────────────────────
# GRAPHITI_ENABLED=false
# GRAPHITI_MCP_URL=
# GRAPHITI_LLM_PROVIDER=openai
# GRAPHITI_EMBEDDER_PROVIDER=openai
# GRAPHITI_DATABASE=magestic_ai_memory
# GRAPHITI_DB_PATH=~/.pfactory/memories
# INSIGHT_EXTRACTION_ENABLED=true
# INSIGHT_EXTRACTOR_MODEL=claude-3-5-haiku-latest
# Insight-extraction batching (Anthropic Batch API).
# PFACTORY_BATCH_DISABLE=          # truthy: force synchronous extraction
# PFACTORY_BATCH_MIN_JOBS=2        # min queued jobs before a batch is submitted
# PFACTORY_BATCH_TIMEOUT=120       # seconds to wait for a batch result


# ─── Docs emission targets (optional) ──────────────────────────────────
# BACKSTAGE_BASE_URL=
# CONFLUENCE_BASE_URL=
# CONFLUENCE_API_TOKEN=
# CONFLUENCE_SPACE=


# ─── Email OAuth integrations (portal) ─────────────────────────────────
# APP_EMAIL_GOOGLE_CLIENT_ID=
# APP_EMAIL_GOOGLE_CLIENT_SECRET=
# APP_EMAIL_MICROSOFT_CLIENT_ID=
# APP_EMAIL_MICROSOFT_CLIENT_SECRET=
# EMAIL_OAUTH_REDIRECT_URI=


# ─── Debug / CLI ───────────────────────────────────────────────────────
# DEBUG=false
# DEBUG_LEVEL=1
# DEBUG_LOG_FILE=
# ENABLE_FANCY_UI=true
# USE_CLAUDE_MD=false
