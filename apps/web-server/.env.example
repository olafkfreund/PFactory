# MagesticAI Web Server Configuration
# Copy this file to .env and modify as needed

# Server settings
APP_HOST=0.0.0.0
APP_PORT=3114
APP_DEBUG=true

# Authentication
# If not set, a token will be auto-generated on first run
# APP_API_TOKEN=your-secure-token-here

# CORS origins — accepts a comma-separated list OR a JSON array.
# Examples:
#   APP_CORS_ORIGINS=https://app.example.com,https://api.example.com
#   APP_CORS_ORIGINS=["http://localhost:3115","http://localhost:3000"]
# Defaults already cover http(s)://localhost:{3000,3115,3114}.
# APP_CORS_ORIGINS=

# Paths (auto-detected if not set)
# APP_BACKEND_PATH=/path/to/apps/backend
# APP_PROJECTS_DATA_DIR=/path/to/data/directory

# Terminal settings
APP_DEFAULT_SHELL=/bin/bash
APP_MAX_TERMINALS=20

# Task execution
APP_MAX_CONCURRENT_TASKS=5

# ─── PFactory portal (Task 9 / #10) ────────────────────────────────────
# Workspace root the /api/pfactory/tasks endpoints scan for spec dirs.
# Default ~/.pfactory. Set to override (tests use this with a tmp dir).
# PFACTORY_WORKSPACE_ROOT=~/.pfactory

# ─── PFactory pipeline auto-advance (the four agent stages) ────────────
# Each defaults to "1" (auto-chain ON). Test fixtures set to "0".
# Production deployments may want some OFF if the operator wants to
# inspect each stage's output before the next fires.
# PFACTORY_AUTO_PLAN=1       # Planner auto-fires from task_create_and_run
# PFACTORY_AUTO_GENERATE=1   # Gen-Functional auto-fires from Planner
# PFACTORY_AUTO_EVALUATE=1   # Evaluator auto-fires from Gen-Functional
# PFACTORY_AUTO_TRIAGE=1     # Triager auto-fires from Evaluator

# ─── Triager side-effect modes (default DRY-RUN — opt in to real-run) ──
# Per CLAUDE.md: "NO automatic pushes to GitHub" — keep these off
# unless the operator has confirmed git_writer/pr_comment are safe.
# PFACTORY_TRIAGER_GIT_WRITE=0   # commit accepted tests to feature branch
# PFACTORY_TRIAGER_PR_COMMENT=0  # post triage report via gh pr comment

# RFC-0001 completion event → CFactory cockpit. Values in .env are loaded into
# os.environ at startup (server/env_bootstrap.py). CFactory ingress is :3111.
# PFACTORY_COMPLETION_WEBHOOK=http://localhost:3111/api/events
# PFACTORY_COMPLETION_WEBHOOK_TIMEOUT=5

# ─── GitHub Agentic Integration (epic #87) ────────────────────────────
# Component 1 — GitHub Models provider. Free OpenAI-compatible inference via
# models.github.ai; select models as github-models/<publisher>/<model>, e.g.
# github-models/openai/gpt-4.1. Auth reuses GITHUB_TOKEN / GH_TOKEN.
# GITHUB_TOKEN=ghp_...

# Component 2 — Copilot cloud-agent dispatch. Opt-in; reuses the gh CLI token
# (needs repo + issues + pull_requests scopes). A `copilot:delegate` label on a
# planning issue assigns it to copilot-swe-agent[bot].
# PFACTORY_COPILOT_DISPATCH_ENABLED=0

# Component 3 — planning-context MCP server (POST /mcp). Bearer token; when
# unset the endpoint is open (dev only). Set in prod + mirror into the GitHub
# repo's COPILOT_MCP_PFACTORY_TOKEN secret.
# PFACTORY_MCP_SECRET=<random-32-char-hex>

# Component 4 — plan-review PR comment. Default DRY-RUN (no automatic pushes):
# the rendered gate summary is returned, not posted, unless opted in.
# PFACTORY_PLAN_REVIEW_COMMENT=0
